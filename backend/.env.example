# Local default. Production must use config.settings.production.
# That module rejects SECRET_KEY=change-me, requires ALLOWED_HOSTS,
# and requires PostgreSQL (DB_NAME, DB_USER, DB_PASSWORD, DB_HOST).
DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite | postgresql
DB_ENGINE=sqlite
DB_NAME=bassaddict
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
