# Public API. No secrets belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional. Absolute site origin, used for canonical URLs, Open Graph, and the sitemap.
# Leave unset until the public domain is known. Do not invent one.
# NEXT_PUBLIC_SITE_URL=https://example.com
